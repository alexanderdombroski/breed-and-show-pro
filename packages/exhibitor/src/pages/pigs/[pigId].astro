---
import Layout from "../../../../shared/layouts/Layout.astro";
const { pigId } = Astro.params as { pigId: string };

const response = await fetch(`http://localhost:3000/pigs/${pigId}`);
const noteResponse = await fetch(`http://localhost:3000/notes/${pigId}`);
const pig = await response.json();
const note = await noteResponse.json();
---

<Layout>
  <div class="pig-detail">
    <h2 class="pig-name">{pig.name}</h2>
    <p><strong>Breed:</strong> {pig.breed}</p>
    <p><strong>Breeding Status:</strong> {pig.status}</p>
    <p><strong>Sex:</strong> {pig.sex}</p>
    <p><strong>Weight:</strong> {note.weight || "N/A"}</p>
    <p>
      <strong>Notes:</strong>
      <span id="note-display">{note.notes || `No notes for ${pig.name}`}</span>
    </p>
    <button id="delete-note-btn" class="btn-delete">Delete Note</button>
    <input type="hidden" id="pig-id" value={pigId} />
    <br />
    <br />
    <div class="note-form">
      <h3>Add or Update Notes for {pig.name}</h3>
      <form
        id="note-form"
        data-pig-id={pigId}
        data-has-note={note.notes ? "true" : "false"}
      >
        <input type="hidden" name="your-hidden-field" value="" />

        <label for="weight">Weight (lbs)</label>
        <input
          type="number"
          id="weight"
          class="weight-input"
          name="weight"
          step="0.1"
          min="0"
          placeholder="e.g., 250"
          required
        />

        <label for="content">Notes</label>
        <textarea
          id="content"
          name="content"
          rows="4"
          placeholder="Enter your note here..."
          required>{note.notes || ""}</textarea
        >
        <button class="add-btn" type="submit">
          {note.notes ? "Update Note" : "Add Note"}
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  const pigName =
    document.getElementById("pig-name")?.textContent || "this pig";
  const form = document.querySelector<HTMLFormElement>("#note-form");
  const noteDisplay = document.getElementById("note-display");
  const deleteBtn = document.getElementById("delete-note-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const pigId = form.getAttribute("data-pig-id");
    const hasNote = form.getAttribute("data-has-note") === "true";

    const formData = new FormData(form);

    // 1. Extract the new fields from the form
    const content = formData.get("content")?.toString() || "";

    // Grab the weight and convert it to a number
    const weightRaw = formData.get("weight");
    const weight = weightRaw ? Number(weightRaw) : undefined;

    // 2. Build the updated payload
    const payload = {
      pigId: pigId,
      notes: content,
      weight: weight,
    };

    const method = hasNote ? "PUT" : "POST";
    const url = hasNote
      ? `http://localhost:3000/notes/${pigId}`
      : `http://localhost:3000/notes`;

    //alert(`Submitting note for ${pigName}:\n\nContent: ${content}\nEvent Date: ${eventDate}\nPiglets Weaned: ${pigletsWeaned ?? "N/A"} \n\nMethod: ${method}\nURL: ${url}`);
    try {
      const response = await fetch(url, {
        method: method,
        headers: {
          "Content-Type": "application/json",
        },
        // 3. Send the entire payload object, not just the notes string
        body: JSON.stringify(payload),
      });

      alert(`Received response with status: ${response.status}`);

      if (response.ok) {
        if (noteDisplay) noteDisplay.textContent = content;

        form.setAttribute("data-has-note", "true");

        const submitBtn = form.querySelector("button[type=\"submit\"]");
        if (submitBtn) submitBtn.textContent = "Update Note";
      } else {
        console.error(`Failed to ${hasNote ? "update" : "create"} note`);
      }
    } catch (error) {
      console.error("Error:", error);
    }
  });

  deleteBtn?.addEventListener("click", async () => {
    const pigId = document.getElementById("pig-id")?.getAttribute("value");
    try {
      const response = await fetch(`http://localhost:3000/notes/${pigId}`, {
        method: "DELETE",
      });

      if (response.ok) {
        alert("Note deleted successfully");
        window.location.reload();
        if (noteDisplay) noteDisplay.textContent = `No notes for ` + pigName;
      } else {
        console.error("Failed to delete note");
      }
    } catch (error) {
      console.error("Error:", error);
    }
  });
</script>

<style>
  .btn-delete {
    background-color: #ef4444;
    color: white;
    border: none;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.1s ease;
  }

  .btn-delete:hover {
    background-color: #fa1212;
  }

  .btn-delete-outline {
    background-color: transparent;
    color: #ef4444;
    border: 1px solid #ef4444;
  }

  .pig-detail {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: system-ui, sans-serif;
    background: rgba(
      255,
      255,
      255,
      0.25
    ); /* Semi-transparent white background */
    backdrop-filter: blur(14px); /* This creates the frosted glass blur */
    -webkit-backdrop-filter: blur(12px); /* Needed for Safari support */
    border-bottom: 1px solid rgba(255, 255, 255, 0.4); /* Subtle top/bottom edge lighting */
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.05); /* Soft shadow for depth */
    padding: 4%;
    border-radius: 8px;
  }

  .pig-detail h2 {
    margin-bottom: 1rem;
  }

  .pig-detail p {
    margin: 0.5rem 0;
  }
  /* Base Container */
  .container {
    max-width: 650px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Roboto,
      sans-serif;
    color: #334155;
  }

  /* Card Styling */
  .card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.05),
      0 2px 4px -2px rgba(0, 0, 0, 0.05);
  }

  /* Typography */
  h2 {
    margin: 0 0 1.5rem 0;
    color: #0f172a;
    font-size: 1.75rem;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.75rem;
  }

  h3 {
    margin: 0 0 1rem 0;
    color: #0f172a;
    font-size: 1.25rem;
  }

  /* Data Grid */
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
    background-color: #f8fafc;
    padding: 1rem;
    border-radius: 8px;
  }

  .details-grid p {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .details-grid span {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  .note-content {
    background-color: #fffbeb; /* Subtle yellow tint for notes */
    border-left: 4px solid #fbbf24;
    padding: 1rem;
    border-radius: 0 8px 8px 0;
    color: #451a03;
    line-height: 1.6;
  }

  /* Form Elements */
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 500px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  .weight-input {
    width: 30%;
    box-sizing: border-box;
    padding: 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1;
    transition: all 0.2s ease;
    background-color: #f8fafc;
  }

  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
    min-height: 120px;
    transition: all 0.2s ease;
    background-color: #f8fafc;
  }

  textarea:focus {
    outline: none;
    background-color: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  /* Button */
  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .add-btn {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.1s ease;
  }

  .add-btn:hover {
    background-color: #2563eb;
  }

  .add-btn:active {
    transform: translateY(1px);
  }
</style>
