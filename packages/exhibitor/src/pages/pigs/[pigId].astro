---
const { pigId } = Astro.params as { pigId: string };

const response = await fetch(`http://localhost:3000/pigs/${pigId}`);
const noteResponse = await fetch(`http://localhost:3000/pigs/${pigId}/notes/${pigId}`);
const pig = await response.json();
const note = await noteResponse.json();

import Layout from "../../../../shared/layouts/Layout.svelte.astro";
---

<Layout>
  <div class="pig-detail">
    <h2>{pig.name}</h2>
    <p><strong>Breed:</strong> {pig.breed}</p>
    <p><strong>Breeding Status:</strong> {pig.status}</p>
    <p><strong>Sex:</strong> {pig.sex}</p>
    <p><strong>Notes:</strong> <span id="note-display">{note.notes || "No notes available."}</span></p>
    <br />
    <div class="note-form">
    <h3>Add or Update Notes for {pig.name}</h3>
    <form id="note-form" data-pig-id={pigId}>
      <textarea name="content" rows="4" cols="50" placeholder="Enter your note here..."></textarea>
      <br />
      <button type="submit">Add Note</button>
    </form>
  </div>
  </div>
</Layout>

<script>
  const form = document.getElementById("note-form");
  const noteDisplay = document.getElementById("note-display");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault(); // Stops the browser from submitting the form natively
    
    const pigId = form.getAttribute("data-pig-id");
    const formData = new FormData(form as HTMLFormElement);
    const content = formData.get("content");

    try {
      const response = await fetch(`http://localhost:3000/pigs/${pigId}/notes/${pigId}`, {
        method: "PUT",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({ notes: content })
      });

      if (response.ok) {
        // Update the DOM immediately without refreshing
        if(noteDisplay) noteDisplay.textContent = content as string;
        (form as HTMLFormElement).reset(); // Clear the textarea
      } else {
        console.error("Failed to update note");
      }
    } catch (error) {
      console.error("Error:", error);
    }
  });
</script>

<style>
  .pig-detail {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: system-ui, sans-serif;
  }

  .pig-detail h2 {
    margin-bottom: 1rem;
  }

  .pig-detail p {
    margin: 0.5rem 0;
  }
   /* Base Container */
  .container {
    max-width: 650px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: #334155;
  }

  /* Card Styling */
  .card {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 2rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  }

  /* Typography */
  h2 {
    margin: 0 0 1.5rem 0;
    color: #0f172a;
    font-size: 1.75rem;
    border-bottom: 2px solid #f1f5f9;
    padding-bottom: 0.75rem;
  }

  h3 {
    margin: 0 0 1rem 0;
    color: #0f172a;
    font-size: 1.25rem;
  }

  strong {
    color: #475569;
    font-weight: 600;
  }

  /* Data Grid */
  .details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
    background-color: #f8fafc;
    padding: 1rem;
    border-radius: 8px;
  }

  .details-grid p {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
  }

  .details-grid span {
    margin-top: 0.25rem;
    font-size: 1.05rem;
    color: #0f172a;
  }

  /* Notes Display */
  .notes-section p {
    margin: 0 0 0.5rem 0;
  }

  .note-content {
    background-color: #fffbeb; /* Subtle yellow tint for notes */
    border-left: 4px solid #fbbf24;
    padding: 1rem;
    border-radius: 0 8px 8px 0;
    color: #451a03;
    line-height: 1.6;
  }

  /* Form Elements */
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    resize: vertical;
    min-height: 120px;
    transition: all 0.2s ease;
    background-color: #f8fafc;
  }

  textarea:focus {
    outline: none;
    background-color: #ffffff;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
  }

  /* Button */
  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  button {
    background-color: #3b82f6;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 8px;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  button:hover {
    background-color: #2563eb;
  }

  button:active {
    transform: translateY(1px);
  }
</style>
