---
// src/pages/events/details.astro (or wherever this file lives)
import Layout from "../../../../shared/layouts/Layout.astro";
import EventDetailsClient from "../../../components/EventDetailsClient.svelte";

const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL;
const BASE_URL = import.meta.env.BASE_URL;
---

<Layout>
  <EventDetailsClient
    serverUrl={SERVER_URL as string}
    baseUrl={BASE_URL as string}
    client:load
  />
</Layout>
