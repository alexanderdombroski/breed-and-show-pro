---
import type { Pig } from "../../shared/types/schemas.ts";
import PigShow from "./PigShow.svelte";
const SERVER_URL = import.meta.env.PUBLIC_SERVER_URL;
const response = await fetch(`${SERVER_URL}/pigs`);
const data = await response.json();
const pigs = Array.isArray(data) ? data : data.pigs || [];
const exhibitorBaseUrl = "/breed-and-show-pro/exhibitor";
---

<div class="pig-container">
  <h2>All Pigs</h2>
  <p class="count-badge">{pigs.length} Pigs total</p>

  {
    pigs.length > 0 ? (
      <div class="pig-grid">
        {pigs.map((pig: Pig) => (
          <div class="pig-card">
            <div class="card-content">
              <a
                href={`${exhibitorBaseUrl}/pigs/details?id=${pig._id}`}
                key-value={pig._id}
              >
                <h3 class="pig-name">{pig.name}</h3>
              </a>
              <div class="divider" />
              <p class="pig-breed">{pig.breed}</p>
              <PigShow {pig} client:load />
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No pigs assigned to you.</p>
      </div>
    )
  }
</div>

<style>
  .pig-container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1rem;
    font-family: system-ui, sans-serif;
  }

  .count-badge {
    color: #666;
    margin-bottom: 2rem;
  }

  /* The Grid Setup */
  .pig-grid {
    display: grid;
    /* This creates as many 280px columns as will fit, then grows them */
    grid-template-columns: repeat(auto-fill, minmax(280px, 2fr));
    column-gap: 50px;
    gap: 1.5rem;
  }

  /* The "Island" Card */
  .pig-card {
    border: 2px solid transparent;
    background: white;
    color: inherit;
    border-radius: 12px;
    padding: 1.5rem;
    border: 1px solid #e0e0e0;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
    display: flex;
    flex-direction: column;
  }

  .pig-card a {
    text-decoration: none; /* Removes underline from link */
  }

  /* Hover Effects */
  .pig-card:hover {
    border-color: #3b82f6;
    box-shadow: 0 10px 15px rgba(0, 0, 0, 0.1);
  }

  .pig-card:hover a h3 {
    color: #3b82f6;
    text-decoration: underline;
  }

  .pig-name {
    margin: 0;
    font-size: 1.25rem;
    color: #1a1a1a;
  }

  .divider {
    height: 2px;
    background: #f0f0f0;
    margin: 0.75rem 0;
  }

  .pig-breed {
    color: #4b5563;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem;
    background: #f3f4f6;
    border-radius: 12px;
    color: #6b7280;
  }
</style>
