---
import Login from "./auth/Login.svelte";
import LoginPopover from "./auth/LoginPopover.svelte";

const baseUrl = import.meta.env.BASE_URL;
const breederBaseUrl = "/breed-and-show-pro/breeder";
const exhibitorBaseUrl = "/breed-and-show-pro/exhibitor";
---

<header class="header">
  <a class="logo" href={baseUrl}>Breed and Show Pro</a>
  <nav class="nav">
    <a href={`${exhibitorBaseUrl}/pigs`} class="active">My Animals</a>
    <a href={`${exhibitorBaseUrl}/calendar`}>Show Calendar</a>
    <div class="dropdown breeder-dropdown">
      <button class="dropdown-toggle" id="breeder-dropdown">
        Breeder
        <span class="dropdown-arrow">▼</span>
      </button>
      <div class="dropdown-menu" id="breeder-menu">
        <a href={breederBaseUrl}>Dashboard</a>
        <a href={`${breederBaseUrl}/herd`}>Herd</a>
        <a href={`${breederBaseUrl}/upcomingDates`}>Upcoming Dates</a>
        <a href={`${breederBaseUrl}/task`}>Tasks</a>
        <a href={baseUrl}>Breeding Calculator</a>
        <a href={`${breederBaseUrl}/profile`}>Profile</a>
      </div>
    </div>
    <div class="dropdown exhibitor-dropdown">
      <button class="dropdown-toggle" id="exhibitor-dropdown">
        Exhibitor
        <span class="dropdown-arrow">▼</span>
      </button>
      <div class="dropdown-menu" id="exhibitor-menu">
        <a href={exhibitorBaseUrl}>Dashboard</a>
        <a href={`${exhibitorBaseUrl}/profile`}>Profile</a>
      </div>
    </div>
  </nav>
  <div class="auth-buttons">
    <LoginPopover client:only="svelte" />
    <Login className="btn-primary" loginText="Login with Google" client:load />
  </div>
</header>

<script>
  function initDropdown(selector: string) {
    const dropdown = document.querySelector(selector) as Element;
    const menu = dropdown.querySelector(".dropdown-menu");
    const toggle = dropdown.querySelector(".dropdown-toggle");
    if (toggle && menu) {
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        menu.classList.toggle("show");
        toggle.classList.toggle("active");
      });

      // Close dropdown when clicking outside
      document.addEventListener("click", () => {
        menu.classList.remove("show");
        toggle.classList.remove("active");
      });
    }
  }
  document.addEventListener("DOMContentLoaded", () => {
    initDropdown(".breeder-dropdown");
    initDropdown(".exhibitor-dropdown");
  });
</script>

<style>
  .dropdown {
    position: relative;
    display: inline-block;
  }

  .dropdown-toggle {
    background: none;
    border: none;
    color: inherit;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 0.2s;
  }

  .dropdown-toggle:hover {
    opacity: 0.8;
  }

  .dropdown-arrow {
    font-size: 0.7em;
    transition: transform 0.2s;
  }

  .dropdown-toggle.active .dropdown-arrow {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    background: white;
    border: 1px solid #ddd;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    min-width: 200px;
    z-index: 1000;
    display: none;
    flex-direction: column;
    margin-top: 0.25rem;
  }

  .dropdown-menu.show {
    display: flex;
  }

  .dropdown-menu a {
    padding: 0.75rem 1rem;
    color: #333;
    text-decoration: none;
    transition: background-color 0.2s;
    border-bottom: 1px solid #f0f0f0;
  }

  .dropdown-menu a:last-child {
    border-bottom: none;
  }

  .dropdown-menu a:hover {
    background-color: #f5f5f5;
  }
</style>
<!-- If prettier fails because of this line it is a bug. Use git commit --no-verify -->
{import.meta.env.DEV && (
  baseUrl.includes("exhibitor") ? (
  <script is:inline>
    document.querySelectorAll(".breeder-dropdown .dropdown-menu a").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const targetHref = a.href.includes("4321")
          ? a.href.replace("4321", "4322")
          : a.href.replace("4322", "4321");
        window.location.href = targetHref;
      });
    });
  </script>
) : (
  <script is:inline>
    document.querySelectorAll(".exhibitor-dropdown .dropdown-menu a").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const targetHref = a.href.includes("4321")
          ? a.href.replace("4321", "4322")
          : a.href.replace("4322", "4321");
        window.location.href = targetHref;
      });
    });
  </script>
))}
