---
import Layout from "../../../../shared/layouts/Layout.svelte.astro";
import Form from "../../components/Form.svelte";
const title = "Breeding Calculator";
---

<Layout title={title}>
  <h1 style="margin-left: 75px;">{title}</h1>
  <Form client:load />
</Layout>

<style>
  body {
    background-image: url(/breed-and-show-pro/breeder/grass-background-blur.jpg);
    background-size: cover;
    background-attachment: fixed;
    background-repeat: no-repeat;
    margin: 0;
  }
</style>
