---
import Layout from "../../../../shared/layouts/Layout.astro";
import AddSowForm from "../../components/AddSowForm.svelte";
import OpenSowList from "../../components/OpenSowList.svelte";
import "../../styles/breeder-pages.css";
const title = "Open";
const baseUrl = import.meta.env.BASE_URL;

import { BreederMockData } from "../../BreederMockData.js";

const openAnimals = BreederMockData.animals.filter(
  (animal) => animal.status === "open",
);

function formatDate(dateString: string): string {
  const date = new Date(dateString);
  const options: Intl.DateTimeFormatOptions = { month: "long", day: "numeric" };
  return date.toLocaleDateString("en-US", options);
}

function getNextHeatDisplay(animal: any): string {
  if (animal.nextHeatDate) {
    return formatDate(animal.nextHeatDate);
  } else {
    return "unknown";
  }
}
---

<Layout title={title}>
  <body>
    <a class="back-link" href="/herd/">Back to Herd</a>

    <div class="form-btns">
      <AddSowForm client:load />
    </div>

    {
      openAnimals.length === 0 ? (
        <p class="message">No open sows at this time.</p>
      ) : (
        <div class="animals-list">
          {openAnimals.map((animal) => (
            <a href={`/herd/sow/${animal.id}`} class="animal-card">
              <div class="animal-info">
                <h2>
                  {animal.name}: {animal.earNotch}
                </h2>
                <p>Next Heat: {getNextHeatDisplay(animal)}</p>
              </div>
              <img
                class="right-arrow"
                src={`${baseUrl}/right-arrow.png`}
                alt="Right Arrow"
              />
            </a>
          ))}
        </div>
      )
    }
    <OpenSowList client:load />
  </body>
</Layout>
