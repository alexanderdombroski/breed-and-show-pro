---
import Layout from "../../../../shared/layouts/Layout.astro";
import "../../styles/breeder-pages.css";

const title = "Bred";
const baseUrl = import.meta.env.BASE_URL;
const breederBaseUrl = "/breed-and-show-pro/breeder";

// Fetch bred sows from API
const API_BASE = import.meta.env.PUBLIC_SERVER_URL;
let bredAnimals = [];
try {
  const res = await fetch(`${API_BASE}/api/pigs`, {
    headers: { "Content-Type": "application/json" },
  });
  if (res.ok) {
    const pigs = await res.json();
    bredAnimals = pigs.filter(
      (pig: any) => pig.status === "bred" && pig.sex === "sow",
    );
  } else {
    console.error("API error:", res.status, res.statusText);
  }
} catch (err) {
  console.error("Failed to fetch bred sows:", err);
}

function formatDate(dateString: string): string {
  const date = new Date(dateString);
  const options: Intl.DateTimeFormatOptions = { month: "long", day: "numeric" };
  return date.toLocaleDateString("en-US", options);
}

function getFarrowingDisplay(animal: any): string {
  if (animal.expectedFarrowDate) {
    return formatDate(animal.expectedFarrowDate);
  }
  return "unknown";
}

function getBreedingDisplay(animal: any): string {
  if (animal.breedingDate) {
    return formatDate(animal.breedingDate);
  }
  return "unknown";
}
---

<Layout title={title}>
  <a class="back-link" href={`${breederBaseUrl}/herd/`}>Back to Herd</a>
  {
    bredAnimals.length === 0 ? (
      <p class="message">No bred sows at this time.</p>
    ) : (
      <div class="animals-list">
        {bredAnimals.map((animal: any) => (
          <a
            href={`${baseUrl}/herd/sow?id=${encodeURIComponent(animal._id)}`}
            class="animal-card"
          >
            <div class="animal-info">
              <h2>
                {animal.name}: {animal.earNotch}
              </h2>
              <p>Bred: {getBreedingDisplay(animal)}</p>
              <p>Est Farrow Date: {getFarrowingDisplay(animal)}</p>
            </div>
            <img
              class="right-arrow"
              src={`${baseUrl}/right-arrow.png`}
              alt="Right Arrow"
            />
          </a>
        ))}
      </div>
    )
  }
</Layout>

<style>
  .animals-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
    width: 90%;
    margin: 20px auto;
  }

  .animal-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    font-size: var(--step--1);
    color: #333;
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-left: 3px solid #f2af29ff;
    padding: 10px 12px;
    border-radius: 4px;
    transition: all 0.2s;
  }

  .animal-card:hover {
    background-color: #fff3e0;
    box-shadow: 0 2px 6px rgba(255, 165, 0, 0.2);
  }

  .animal-info h2 {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .animal-info p {
    margin: 4px 0 0 0;
    font-size: var(--step--1);
    color: #666;
  }

  @media (min-width: 1000px) {
    .animals-list {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      width: 80%;
      max-width: 1000px;
      margin: 20px auto;
    }

    .animal-card {
      height: 100px;
    }
  }
</style>
