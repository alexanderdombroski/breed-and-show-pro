---
import Layout from "../../../../shared/layouts/Layout.astro";
const title = "Sires";

import { BreederMockData } from "../../BreederMockData.js";

const activeSires = BreederMockData.animals.filter(
  (animal) => animal.status === "active" && animal.sex === "boar",
);
---

<Layout title={title} client:load>
  <a href="/herd/">Back to Herd</a>
  {
    activeSires.length === 0 ? (
      <p class="message">No active sires at this time.</p>
    ) : (
      <div class="animals-list">
        {activeSires.map((animal) => (
          <a href="#" class="animal-card">
            <div class="animal-info">
              <h2>
                {animal.name}: {animal.earNotch}
              </h2>
            </div>
            <img class="right-arrow" src="/right-arrow.png" alt="Right Arrow" />
          </a>
        ))}
      </div>
    )
  }
</Layout>

<style>
  .animals-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
    margin-top: 20px;
  }

  .animals-list a {
    width: 90%;
    margin: 0 auto;
  }

  .animal-card {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: black;
    background-color: #f2af29ff;
    padding: 10px 15px;
    border-radius: 5px;
  }

  .animal-card:hover {
    background-color: #f0b746cc;
  }

  .animal-info h2 {
    margin: 0;
    margin-bottom: -4px;
    font-size: 1.2em;
  }

  .right-arrow {
    width: 16px;
    height: 16px;
    margin-left: 10px;
    justify-content: center;
    display: inline-flex;
    vertical-align: middle;
  }

  .message {
    text-align: center;
    font-size: 1.2em;
    color: #555;
    margin-top: 40px;
  }
</style>
