---
import Layout from "../../../../shared/layouts/Layout.astro";
import "../../styles/breeder-pages.css";
import UpcomingDatesFilter from "../../components/UpcomingDatesFilter.svelte";

const title = "Upcoming Dates";
const breederBaseUrl = "/breed-and-show-pro/breeder";
---

<Layout title={title}>
  <body>
    <a class="back-link" href={`${breederBaseUrl}/`}>Back to Dashboard</a>

    <UpcomingDatesFilter client:load />
  </body>
</Layout>

<style>
  body {
    background-image: url(/breed-and-show-pro/breeder/grass-background-blur.jpg);
    background-size: cover;
    background-attachment: fixed;
    background-repeat: no-repeat;
    margin: 0;
  }
</style>
