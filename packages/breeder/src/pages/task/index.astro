---
import Layout from "../../../../shared/layouts/Layout.svelte.astro";
import "../../styles/breeder-pages.css";
import TaskModal from "../../components/TaskModal.svelte";
import { BreederMockData } from "../../BreederMockData.js";
const title = "Tasks";
const tasks = BreederMockData.tasks;

const isDatePast = (dateString: string) => {
  const dueDate = new Date(dateString);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return dueDate < today;
};
---

<Layout title={title} client:load>
  <body>
    <a class="back-link" href="/">Back to Dashboard</a>

    <div class="form-btns">
      <TaskModal client:load />
    </div>

    {
      tasks.length === 0 ? (
        <p class="message">No tasks at this time.</p>
      ) : (
        <div class="tasks-list">
          {tasks.map((task) => (
            <div class="task-card">
              <input class="checkbox" type="checkbox" />
              <div class="task-info">
                <h2>{task.title}</h2>
                {task.description && (
                  <p class="description">{task.description}</p>
                )}
                {task.dueDate && (
                  <p
                    class={`due-date ${isDatePast(task.dueDate) ? "past-date" : "future-date"}`}
                  >
                    Due: {new Date(task.dueDate).toLocaleDateString()}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      )
    }
  </body>
</Layout>

<style>
  /* Override form-btns to match tasks-list width */
  .form-btns {
    width: 90%;
    max-width: 800px;
  }

  .checkbox {
    margin-right: 15px;
    transform: scale(1.5);
  }

  .tasks-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 20px;
    margin-top: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    width: 90%;
  }

  .task-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    border: 1px solid #ddd;
    border-left: 4px solid #f2af29ff;
    background-color: white;
    padding: 15px 20px;
    border-radius: 5px;
    cursor: pointer;
    transition: box-shadow 0.2s;
  }

  .task-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .task-info h2 {
    margin: 0 0 8px 0;
    font-size: 1.2em;
    color: #333;
  }

  .task-info p {
    margin: 0 0 4px 0;
    font-size: 0.9em;
  }

  .description {
    line-height: 1.4;
    color: #666;
  }

  .due-date {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .past-date {
    color: rgb(170, 0, 0);
  }

  .future-date {
    color: rgb(1, 83, 1);
  }
</style>
