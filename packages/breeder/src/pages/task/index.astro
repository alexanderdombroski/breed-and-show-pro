---
import Layout from "../../../../shared/layouts/Layout.astro";
import "../../styles/breeder-pages.css";
import TaskModal from "../../components/TaskModal.svelte";
const title = "Tasks";

const isDatePast = (dateString: string) => {
  const dueDate = new Date(dateString);
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  return dueDate < today;
};

async function fetchTasks() {
  const BASE_URL = import.meta.env.PUBLIC_SERVER_URL;
  const response = await fetch(`${BASE_URL}/tasks`, {
    method: "GET",
  });
  const tasks = await response.json();
  const allTasks = tasks.filter((task: any) => task._type === "task");

  // Sort tasks by due date (earliest first, no date at end)
  allTasks.sort((a: any, b: any) => {
    // If neither has a due date, maintain order
    if (!a.dueDate && !b.dueDate) return 0;
    // Tasks without due dates go to the end
    if (!a.dueDate) return 1;
    if (!b.dueDate) return -1;
    // Sort by due date (earliest first)
    return new Date(a.dueDate).getTime() - new Date(b.dueDate).getTime();
  });

  return allTasks;
}

const tasks = await fetchTasks();
const incompleteTasks = tasks.filter((task: any) => !task.isCompleted);
const completedTasks = tasks.filter((task: any) => task.isCompleted);
---

<Layout title={title}>
  <body>
    <a class="back-link" href="/">Back to Dashboard</a>

    <div class="form-btns">
      <TaskModal client:load />
      {
        completedTasks.length > 0 && (
          <button class="toggle-completed-btn" id="toggleCompletedBtn">
            Show Completed Tasks
          </button>
        )
      }
    </div>

    {
      incompleteTasks.length === 0 && completedTasks.length === 0 ? (
        <p class="message">No tasks at this time.</p>
      ) : (
        <>
          <div class="tasks-list" id="incompleteTasksList">
            {incompleteTasks.map((task: any) => (
              <div class="task-card" data-completed={task.isCompleted}>
                <input
                  class="checkbox"
                  type="checkbox"
                  checked={task.isCompleted}
                  data-task-id={task._id}
                />
                <div class="task-info">
                  <h2>{task.title}</h2>
                  {(task.description || task.notes) && (
                    <p class="description">{task.description || task.notes}</p>
                  )}
                  {task.dueDate && (
                    <p
                      class={`due-date ${isDatePast(task.dueDate) ? "past-date" : "future-date"}`}
                    >
                      Due: {new Date(task.dueDate).toLocaleDateString()}
                    </p>
                  )}
                </div>
                <button
                  class="delete-btn"
                  data-task-id={task._id}
                  title="Delete task"
                >
                  ✕
                </button>
              </div>
            ))}
          </div>

          {completedTasks.length > 0 && (
            <div class="tasks-list hidden" id="completedTasksList">
              {completedTasks.map((task: any) => (
                <div class="task-card" data-completed={task.isCompleted}>
                  <input
                    class="checkbox"
                    type="checkbox"
                    checked={task.isCompleted}
                    data-task-id={task._id}
                  />
                  <div class="task-info">
                    <h2>{task.title}</h2>
                    {(task.description || task.notes) && (
                      <p class="description">
                        {task.description || task.notes}
                      </p>
                    )}
                    {task.dueDate && (
                      <p
                        class={`due-date ${isDatePast(task.dueDate) ? "past-date" : "future-date"}`}
                      >
                        Due: {new Date(task.dueDate).toLocaleDateString()}
                      </p>
                    )}
                  </div>
                  <button
                    class="delete-btn"
                    data-task-id={task._id}
                    title="Delete task"
                  >
                    ✕
                  </button>
                </div>
              ))}
            </div>
          )}
        </>
      )
    }

    <script>
      const BASE_URL = import.meta.env.PUBLIC_SERVER_URL;

      document.addEventListener("DOMContentLoaded", () => {
        const checkboxes = document.querySelectorAll(".checkbox");
        const toggleBtn = document.getElementById("toggleCompletedBtn");
        const completedTasksList =
          document.getElementById("completedTasksList");
        let showingCompleted = false;

        // Toggle completed tasks visibility
        if (toggleBtn && completedTasksList) {
          toggleBtn.addEventListener("click", () => {
            showingCompleted = !showingCompleted;
            if (showingCompleted) {
              completedTasksList.classList.remove("hidden");
              toggleBtn.textContent = "Hide Completed Tasks";
            } else {
              completedTasksList.classList.add("hidden");
              toggleBtn.textContent = "Show Completed Tasks";
            }
          });
        }

        // Handle delete buttons
        const deleteButtons = document.querySelectorAll(".delete-btn");
        deleteButtons.forEach((button) => {
          button.addEventListener("click", async (e) => {
            const target = e.target as HTMLButtonElement;
            const taskId = target.dataset.taskId;
            const taskCard = target.closest(".task-card");

            if (!confirm("Are you sure you want to delete this task?")) {
              return;
            }

            try {
              const response = await fetch(`${BASE_URL}/tasks/${taskId}`, {
                method: "DELETE",
              });

              if (response.ok) {
                // Remove task card from DOM
                if (taskCard) {
                  taskCard.remove();
                }
              } else {
                console.error("Failed to delete task");
                alert("Failed to delete task. Please try again.");
              }
            } catch (error) {
              console.error("Error deleting task:", error);
              alert("Error deleting task. Please try again.");
            }
          });
        });

        // Handle checkbox changes
        checkboxes.forEach((checkbox) => {
          checkbox.addEventListener("change", async (e) => {
            const target = e.target as HTMLInputElement;
            const taskId = target.dataset.taskId;
            const isCompleted = target.checked;
            const taskCard = target.closest(".task-card");

            try {
              const response = await fetch(`${BASE_URL}/tasks/${taskId}`, {
                method: "PUT",
                headers: {
                  "Content-Type": "application/json",
                },
                body: JSON.stringify({
                  isCompleted: isCompleted,
                  completedAt: isCompleted ? new Date().toISOString() : null,
                }),
              });

              if (response.ok) {
                // Update visual state
                if (taskCard) {
                  taskCard.setAttribute(
                    "data-completed",
                    isCompleted.toString(),
                  );
                  // Move task to appropriate list
                  if (isCompleted) {
                    // Move to completed list
                    const completedList =
                      document.getElementById("completedTasksList");
                    if (completedList) {
                      completedList.appendChild(taskCard);
                    }
                  } else {
                    // Move to incomplete list
                    const incompleteList = document.getElementById(
                      "incompleteTasksList",
                    );
                    if (incompleteList) {
                      incompleteList.appendChild(taskCard);
                    }
                  }
                }
              } else {
                console.error("Failed to update task");
                // Revert checkbox if update failed
                target.checked = !isCompleted;
              }
            } catch (error) {
              console.error("Error updating task:", error);
              // Revert checkbox if update failed
              target.checked = !isCompleted;
            }
          });
        });
      });
    </script>
  </body>
</Layout>

<style>
  .message {
    text-align: center;
    color: #666;
    margin: 40px 0;
    font-size: 1.1em;
  }

  /* Override form-btns to match tasks-list width */
  .form-btns {
    width: 90%;
    max-width: 800px;
    display: flex;
    gap: 15px;
    align-items: center;
  }

  .toggle-completed-btn {
    background-color: #666;
    color: white;
    padding: 10px 20px;
    border: none;
    border-radius: 5px;
    font-size: 0.95em;
    cursor: pointer;
    transition: background-color 0.2s;
    white-space: nowrap;
  }

  .toggle-completed-btn:hover {
    background-color: #555;
  }

  .tasks-list.hidden {
    display: none !important;
  }

  .checkbox {
    margin-right: 15px;
    transform: scale(1.5);
    cursor: pointer;
    flex-shrink: 0;
  }

  .delete-btn {
    background: none;
    color: #333;
    border: none;
    font-size: 1.5em;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    padding: 5px 10px;
  }

  .delete-btn:hover {
    color: #000;
    transform: scale(1.2);
  }

  .tasks-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 20px;
    margin-top: 40px;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    width: 90%;
  }

  .task-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    border: 1px solid #ddd;
    border-left: 4px solid #f2af29ff;
    background-color: white;
    padding: 15px 20px;
    border-radius: 5px;
    cursor: pointer;
    transition: box-shadow 0.2s;
  }

  .task-card:hover {
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  .task-card[data-completed="true"] {
    opacity: 0.7;
    background-color: #f9f9f9;
  }

  .task-card[data-completed="true"] .task-info h2,
  .task-card[data-completed="true"] .task-info p {
    text-decoration: line-through;
    color: #888;
  }

  .task-info h2 {
    margin: 0 0 8px 0;
    font-size: 1.2em;
    color: #333;
  }

  .task-info p {
    margin: 0 0 4px 0;
    font-size: 0.9em;
  }

  .description {
    line-height: 1.4;
    color: #666;
  }

  .due-date {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .past-date {
    color: rgb(170, 0, 0);
  }

  .future-date {
    color: rgb(1, 83, 1);
  }
</style>
