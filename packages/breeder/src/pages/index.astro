---
import Dashboard from "../../../shared/layouts/Dashboard.svelte";
import Layout from "../../../shared/layouts/Layout.astro";
const title = "Home";
---

<Layout title={title}>
  <body>
    <Dashboard client:load />
  </body>
</Layout>

<style>
  body {
    background-image: url(/grass-background-blur.jpg);
    background-size: cover;
    background-attachment: fixed;
    background-repeat: no-repeat;
    margin: 0;
  }
</style>
